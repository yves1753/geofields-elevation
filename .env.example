# Copy to .env.local for local development. Do NOT commit real secrets.
# This project runs on the Lovable / Cloudflare Workers SSR pipeline.
# No environment variables are required for the default build.

# Client-exposed vars must be prefixed with VITE_
# VITE_PUBLIC_SITE_URL=https://geofields.co.tz

# Server-only vars (available in server functions / route handlers):
# CONTACT_FORWARD_EMAIL=
